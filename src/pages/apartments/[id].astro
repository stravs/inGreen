---
import Layout from '../../layouts/Layout.astro';
import Photo from '../../components/Photo.astro';
import UnitCard from '../../components/UnitCard.astro';
import Enquire from '../../components/Enquire.astro';
import Lightbox from '../../components/Lightbox.astro';
import { units, type Unit } from '../../data/house';

export function getStaticPaths() {
  return units.map(unit => ({ params: { id: unit.id }, props: { unit } }));
}

interface Props { unit: Unit }
const { unit } = Astro.props;
const others = units.filter(u => u.id !== unit.id);
const gallery = unit.photos.filter(id => id !== unit.hero);
const eyebrow = 'text-xs font-semibold uppercase tracking-[0.16em]';
---
<Layout title={`${unit.name} — InGreen House, Obrne`}
  description={`${unit.area} m², sleeps ${unit.sleeps}. ${unit.text}`}>
  <main id="top">
    <!-- Hero: the apartment's own best photo -->
    <section class="relative isolate flex h-[85svh] min-h-[34rem] flex-col justify-end overflow-hidden bg-forest text-paper" aria-labelledby="unit-title">
      <Photo id={unit.hero} eager sizes="100vw" class="absolute inset-0 -z-10 h-full motion-safe:animate-settle" />
      <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-t from-forest via-forest/60 via-30% to-forest/0 to-70%"></div>
      <div aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-40 bg-gradient-to-b from-forest/60 to-forest/0"></div>
      <div class="mx-auto w-full max-w-6xl px-5 pb-10 sm:px-8 sm:pb-14">
        <p class={`${eyebrow} text-paper`}><a href="/#house" class="underline-offset-4 hover:underline">Apartments</a> · {unit.area} m² · {unit.sleeps}</p>
        <h1 id="unit-title" class="mt-4 font-display text-[clamp(3rem,8vw,6.5rem)] leading-[0.92] tracking-tight [text-shadow:0_2px_30px_rgb(27_47_34/.45)]">{unit.name}</h1>
        <div class="mt-3 flex flex-wrap items-end justify-between gap-6">
          <p class="font-display text-3xl italic text-river">{unit.nickname}</p>
          <button type="button" data-lightbox-open="0" class="cursor-pointer rounded-full border border-paper/60 px-5 py-2.5 text-sm font-medium transition-colors hover:bg-paper hover:text-forest">All {unit.photos.length} photos</button>
        </div>
      </div>
    </section>

    <!-- Details -->
    <section class="mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 lg:grid-cols-12 lg:py-20">
      <div class="lg:col-span-7">
        <p class="text-xl leading-relaxed sm:text-2xl">{unit.text}</p>
        <div class="mt-10 border-t border-ink/15 pt-5">
          <h2 class={`${eyebrow} text-jade`}>The outdoor room</h2>
          <p class="mt-3 font-display text-3xl leading-tight">{unit.outdoor}</p>
        </div>
      </div>
      <div class="lg:col-span-5">
        <dl class="grid grid-cols-2 gap-x-6 border-t border-ink/15">
          {[
            ['Size', `${unit.area} m²`],
            ['Sleeps', unit.sleeps],
            ['Bedrooms', String(unit.bedrooms)],
            ['Bathrooms', String(unit.bathrooms)],
          ].map(([k, v]) => (
            <div class="border-b border-ink/15 py-3"><dt class="text-sm text-muted">{k}</dt><dd class="mt-0.5">{v}</dd></div>
          ))}
          <div class="col-span-2 border-b border-ink/15 py-3"><dt class="text-sm text-muted">Beds</dt><dd class="mt-0.5">{unit.beds}</dd></div>
          <div class="col-span-2 border-b border-ink/15 py-3"><dt class="text-sm text-muted">Access</dt><dd class="mt-0.5">{unit.access}</dd></div>
        </dl>
        <ul class="mt-5 flex flex-wrap gap-2 text-sm">
          {unit.extras.map(e => <li class="rounded-full border border-ink/20 px-3 py-1">{e}</li>)}
        </ul>
        <a href="#enquire" class="mt-8 inline-flex items-center gap-2 rounded-full bg-forest px-6 py-3.5 text-sm font-medium text-paper transition-colors hover:bg-moss">Enquire about this apartment</a>
      </div>
    </section>

    <!-- Photos: Booking's own photo associations for this unit -->
    <section class="mx-auto max-w-6xl px-5 pb-16 sm:px-8 lg:pb-20" aria-labelledby="photos-title">
      <h2 id="photos-title" class="font-display text-4xl">Photos <span class="font-body text-base text-muted">· {unit.photos.length}</span></h2>
      <div class="mt-8 columns-1 gap-3 sm:columns-2 lg:columns-3">
        {gallery.map(id => (
          <button type="button" data-lightbox-open={unit.photos.indexOf(id)} aria-label="Open photo full screen"
            class="group mb-3 block w-full cursor-zoom-in overflow-hidden rounded-sm break-inside-avoid">
            <Photo id={id} sizes="(min-width: 1024px) 370px, (min-width: 640px) 50vw, 100vw" class="transition-transform duration-300 group-hover:scale-[1.03]" />
          </button>
        ))}
      </div>
    </section>
    <Lightbox photos={unit.photos} label={`${unit.name}: photos`} />

    <!-- The other apartments -->
    <section class="bg-fog" aria-labelledby="others-title">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 lg:py-20">
        <h2 id="others-title" class="font-display text-4xl sm:text-5xl">The other apartments</h2>
        <ul class="mt-10 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {others.map(u => <li><UnitCard unit={u} /></li>)}
        </ul>
      </div>
    </section>

    <Enquire unit={unit.id} />
  </main>
</Layout>
