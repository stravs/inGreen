---
import { airbnb, booking, bookingIn, directions, street, unitsIn } from '../data/house';
import { miska } from '../data/miska';
import { useCopy } from '../i18n';

interface Props { unit?: string }
const { unit = '' } = Astro.props;
const { lang, c } = useCopy(Astro);
const t = c.enquire;
const units = unitsIn(c);
// Studio Miška is a separate house: its page shows its own address and listings.
const place = unit === miska.id ? miska : { street, booking, airbnb, directions };
const cta = 'inline-flex items-center gap-2 rounded-full px-6 py-3.5 text-sm font-medium transition-colors';
const label = 'block text-sm font-medium';
const field = 'mt-1.5 block w-full rounded-sm border border-ink/25 bg-white/70 px-3 py-2.5 text-base focus:border-jade';
// Cally month styling via ::part, see https://wicky.nillia.ms/cally/
const month = [
  'mx-auto [--color-accent:var(--color-forest)] [--color-text-on-accent:var(--color-paper)]',
  '[&::part(heading)]:pb-2 [&::part(heading)]:font-display [&::part(heading)]:text-2xl',
  '[&::part(th)]:text-xs [&::part(th)]:font-medium [&::part(th)]:text-muted',
  '[&::part(button)]:size-11 [&::part(button)]:cursor-pointer [&::part(button)]:rounded-full [&::part(button)]:text-base',
  '[&::part(today)]:font-bold [&::part(today)]:underline [&::part(today)]:underline-offset-4',
  '[&::part(range-inner)]:rounded-none [&::part(range-inner)]:bg-river/35 [&::part(range-inner)]:text-ink',
  '[&::part(disallowed)]:cursor-default [&::part(disallowed)]:line-through',
].join(' ');
---
<!-- Enquire: the main call to action -->
<section id="enquire" class="bg-forest text-paper" aria-labelledby="enquire-title">
  <div class="mx-auto grid max-w-6xl gap-12 px-5 py-20 sm:px-8 lg:grid-cols-12 lg:py-24">
    <div class="lg:col-span-5">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-river">{t.eyebrow}</p>
      <h2 id="enquire-title" class="mt-4 font-display text-5xl leading-none sm:text-7xl">{t.h2}</h2>
      <p class="mt-6 text-lg leading-relaxed text-paper/85">{t.text}</p>
      <address class="mt-8 not-italic text-paper/80">{place.street}, {c.country}</address>
      <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm font-medium">
        <a href={place.directions} rel="noopener" target="_blank" class="underline underline-offset-4 hover:text-river">{t.directions}</a>
        <a href={bookingIn(place.booking, lang)} rel="noopener" target="_blank" class="underline underline-offset-4 hover:text-river">{t.booking}</a>
        <a href={place.airbnb} rel="noopener" target="_blank" class="underline underline-offset-4 hover:text-river">{t.airbnb}</a>
      </div>
    </div>

    <form id="enquiry-form" data-strings={JSON.stringify(t.client)} class="rounded-sm bg-paper p-6 text-ink sm:p-8 lg:col-span-7">
      <fieldset disabled id="enquiry-fields" class="grid grid-cols-2 gap-x-4 gap-y-5 sm:gap-x-5">
        <legend class="sr-only">{t.legend}</legend>
        <label class={`${label} col-span-2 sm:col-span-1`}>{t.name}<input name="name" autocomplete="name" required maxlength="100" class={field} /></label>
        <label class={`${label} col-span-2 sm:col-span-1`}>{t.email}<input name="email" type="email" autocomplete="email" required maxlength="254" class={field} /></label>
        <label class={`${label} col-span-2`}>{t.apartment}
          <select name="unit" class={field}>
            <option value="">{t.choose}</option>
            {units.map(u => <option value={u.id} selected={u.id === unit}>{u.name} ({u.sleeps})</option>)}
            <option value={miska.id} selected={unit === miska.id}>{t.miskaOption(c.miska.sleeps)}</option>
          </select>
          <span id="unit-note" class="mt-1.5 block text-sm font-normal text-muted" hidden>{t.miskaNote}</span>
        </label>
        <div class="col-span-2">
          <button type="button" id="dates-trigger" aria-haspopup="dialog" aria-describedby="dates-note" class="grid w-full cursor-pointer grid-cols-2 divide-x divide-ink/25 rounded-sm border border-ink/25 bg-white/70 text-left hover:border-ink/50">
            <span class="px-3 py-2.5"><span class="block text-xs font-semibold uppercase tracking-wider text-muted">{t.arrival}</span><span id="arrival-text">{t.addDate}</span></span>
            <span class="px-3 py-2.5"><span class="block text-xs font-semibold uppercase tracking-wider text-muted">{t.departure}</span><span id="departure-text">{t.addDate}</span></span>
          </button>
          <p id="dates-note" class="mt-1.5 text-sm text-muted empty:hidden"></p>
          <input type="hidden" name="arrival" /><input type="hidden" name="departure" />
        </div>
        <label class={label}>{t.adults}<input name="adults" type="number" min="1" value="2" required class={field} /></label>
        <label class={label}>{t.children}<input name="children" type="number" min="0" value="0" required class={field} /></label>
        <label class={`${label} col-span-2`}>{t.message}
          <textarea name="message" rows="4" maxlength="3000" class={field} placeholder={t.placeholder}></textarea>
        </label>
        <button type="submit" class={`${cta} cursor-pointer justify-center bg-forest text-paper hover:bg-moss col-span-2 sm:justify-self-start`}>{t.send}</button>
      </fieldset>
      <p id="enquiry-status" role="status" tabindex="-1" class="mt-4 text-sm font-medium text-jade empty:hidden"></p>
      <noscript><p class="mt-4 text-sm text-muted">{t.noscript}</p></noscript>
    </form>
  </div>

  <dialog id="dates-dialog" closedby="any" aria-labelledby="dates-title" class="m-0 h-dvh max-h-none w-full max-w-none flex-col bg-paper text-ink backdrop:bg-ink/60 open:flex sm:m-auto sm:h-fit sm:max-h-[calc(100dvh-2rem)] sm:w-fit sm:rounded-sm">
    <header class="flex items-start justify-between gap-4 border-b border-ink/15 px-5 py-4">
      <div>
        <h3 id="dates-title" class="font-display text-3xl leading-none">{t.stay}</h3>
        <p id="dates-summary" class="mt-1 text-sm text-muted" aria-live="polite"></p>
      </div>
      <button type="button" data-close aria-label={t.closeLabel} class="-mr-2 cursor-pointer rounded-full p-2 text-2xl leading-none hover:bg-ink/10">×</button>
    </header>
    <div class="flex-1 overflow-y-auto overscroll-contain px-5 py-5">
      <calendar-range id="dates-range" months="13" locale={t.client.locale} first-day-of-week="1" class="mx-auto block w-full max-sm:[&::part(header)]:hidden [&::part(months)]:grid [&::part(months)]:gap-8 sm:[&::part(months)]:flex sm:[&>calendar-month:nth-of-type(n+3)]:hidden [&::part(button)]:cursor-pointer [&::part(button)]:rounded-full [&::part(button)]:p-2 [&::part(button)]:hover:bg-ink/10 [&::part(heading)]:hidden">
        <span slot="previous" aria-label={t.prevMonths}>←</span>
        <span slot="next" aria-label={t.nextMonths}>→</span>
        {Array.from({ length: 13 }, (_, i) => <calendar-month offset={i} class={month} />)}
      </calendar-range>
    </div>
    <footer class="flex items-center justify-between border-t border-ink/15 px-5 py-4">
      <button type="button" id="dates-clear" class="cursor-pointer text-sm font-medium underline underline-offset-4 hover:text-jade">{t.clear}</button>
      <button type="button" data-close class={`${cta} cursor-pointer bg-forest text-paper hover:bg-moss`}>{t.done}</button>
    </footer>
  </dialog>
</section>

<script>
  import 'cally';
  // Enquiry form. Delivery is not connected: validate, then say plainly that nothing was sent.
  const form = document.querySelector<HTMLFormElement>('#enquiry-form')!;
  const s = JSON.parse(form.dataset.strings!) as Record<string, string>;
  const fields = document.querySelector<HTMLFieldSetElement>('#enquiry-fields')!;
  const status = document.querySelector<HTMLElement>('#enquiry-status')!;
  const input = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
  const $ = (id: string) => document.getElementById(id)!;
  const arrival = input('arrival'), departure = input('departure');
  const trigger = $('dates-trigger'), note = $('dates-note'), summary = $('dates-summary');
  const dialog = $('dates-dialog') as HTMLDialogElement;
  const range = document.querySelector('calendar-range')!;
  fields.disabled = false;

  // Studio Miška is adults only.
  const unitSelect = form.elements.namedItem('unit') as HTMLSelectElement, children = input('children');
  const checkUnit = () => {
    const adultsOnly = unitSelect.value === 'studio-miska';
    $('unit-note').hidden = !adultsOnly;
    children.setCustomValidity(adultsOnly && Number(children.value) > 0 ? s.adultsOnly : '');
  };
  unitSelect.addEventListener('change', checkUnit);
  children.addEventListener('input', checkUnit);
  checkUnit();

  // Two months side by side on wider screens; a scrolling list on phones.
  // 13, not 12: Cally treats exactly 12 months as a January–December year view.
  const wide = matchMedia('(min-width: 40rem)');
  const setMonths = () => { range.months = wide.matches ? 2 : 13; };
  setMonths();
  wide.addEventListener('change', setMonths);

  const now = new Date();
  range.min = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
  const day = new Intl.DateTimeFormat(s.locale, { weekday: 'short', day: 'numeric', month: 'short' });
  const show = (iso: string) => day.format(new Date(`${iso}T12:00`));
  const nights = (a: string, b: string) => Math.round((Date.parse(b) - Date.parse(a)) / 864e5);
  // Slovenian: 1, 101… noč; otherwise noči. English: 1 night; otherwise nights.
  const one = (n: number) => (s.locale.startsWith('sl') ? n % 100 === 1 : n === 1);
  const plural = (n: number) => `${n} ${one(n) ? s.night : s.nights}`;

  const render = () => {
    const [a = '', b = ''] = range.value ? range.value.split('/') : [];
    arrival.value = a; departure.value = b;
    $('arrival-text').textContent = a ? show(a) : s.addDate;
    $('departure-text').textContent = b ? show(b) : s.addDate;
    note.className = 'mt-1.5 text-sm text-muted empty:hidden';
    note.textContent = a ? plural(nights(a, b)) : '';
    summary.textContent = a ? `${show(a)} → ${show(b)} · ${plural(nights(a, b))}` : s.chooseArrival;
  };

  range.addEventListener('rangestart', () => { summary.textContent = s.chooseDeparture; });
  range.addEventListener('change', () => {
    const [a, b] = range.value.split('/');
    if (a === b) { range.value = ''; range.tentative = a; summary.textContent = s.oneNight; return; }
    render();
  });
  $('dates-clear').addEventListener('click', () => { range.value = ''; range.tentative = ''; render(); });
  dialog.querySelectorAll('[data-close]').forEach(b => b.addEventListener('click', () => dialog.close()));
  dialog.addEventListener('close', () => { range.tentative = ''; render(); trigger.focus(); });
  trigger.addEventListener('click', () => { dialog.showModal(); range.focus(); });
  render();

  form.addEventListener('submit', e => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    if (!arrival.value) {
      note.className = 'mt-1.5 text-sm font-medium text-red-700';
      note.textContent = s.needDates;
      trigger.focus();
      return;
    }
    status.textContent = s.notSent;
    status.focus();
  });
</script>
