---
import { airbnb, booking, bookingIn, directions, nav } from '../data/house';
import { miska } from '../data/miska';
import { useCopy } from '../i18n';

const { lang, c, url } = useCopy(Astro);
const eyebrow = 'text-xs font-semibold uppercase tracking-[0.16em]';
---
<!-- Footer: continues the forest of the enquiry section, a quiet sign-off -->
<footer class="bg-ink text-paper/75">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 pb-10 pt-16 sm:grid-cols-2 sm:px-8 lg:grid-cols-12">
    <div class="sm:col-span-2 lg:col-span-5">
      <a href={url('/')} class="font-display text-4xl text-paper">InGreen House</a>
      <p class="mt-4 max-w-sm font-display text-xl italic leading-snug text-river">{c.footer.tagline}</p>
      <p class="mt-4 max-w-sm text-sm leading-relaxed">{c.footer.text}</p>
    </div>
    <nav aria-label={c.footer.label} class="lg:col-span-3 lg:col-start-7">
      <h2 class={`${eyebrow} text-paper`}>{c.footer.explore}</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {[[url('/#house'), c.nav.apartments], ...nav.map(id => [url(`/#${id}`), c.nav[id]]), [url(miska.href), miska.name], ['#enquire', c.nav.enquire]].map(([href, name]) => (
          <li><a href={href} class="underline-offset-4 hover:text-river hover:underline">{name}</a></li>
        ))}
      </ul>
    </nav>
    <div class="lg:col-span-3">
      <h2 class={`${eyebrow} text-paper`}>{c.footer.find}</h2>
      <address class="mt-4 text-sm not-italic leading-relaxed">Obrne 2<br />4263 Bohinjska Bela<br />{c.country}</address>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a href={directions} rel="noopener" target="_blank" class="underline-offset-4 hover:text-river hover:underline">{c.footer.directions}</a></li>
        <li><a href={bookingIn(booking, lang)} rel="noopener" target="_blank" class="underline-offset-4 hover:text-river hover:underline">Booking.com ↗</a></li>
        <li><a href={airbnb} rel="noopener" target="_blank" class="underline-offset-4 hover:text-river hover:underline">Airbnb ↗</a></li>
      </ul>
    </div>
  </div>
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="flex flex-wrap items-center justify-between gap-4 border-t border-paper/15 py-6 text-xs">
      <p>© {new Date().getFullYear()} {c.footer.copyright}</p>
      <a href="#top" class="hover:text-river">{c.footer.top}</a>
    </div>
  </div>
</footer>
